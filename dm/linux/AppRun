#!/bin/sh
set -eu

APPDIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
DM_ROOT=${DM_ROOT:-"$HOME/dm-work"}
GAME_DATA=${DM_GAME_DATA:-"$DM_ROOT/Diablo3Mobile"}
BUNDLED_PACK="$APPDIR/usr/share/diablo3-port/runtime"

# Armada's Gamescope session keeps its Xwayland display in this environment file.
if [ -z "${DISPLAY:-}" ] && [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -r "$XDG_RUNTIME_DIR/gamescope-environment" ]; then
    while IFS='=' read -r key value; do
        case "$key" in
            DISPLAY) DISPLAY=$value ;;
            GAMESCOPE_WAYLAND_DISPLAY) GAMESCOPE_WAYLAND_DISPLAY=$value ;;
        esac
    done < "$XDG_RUNTIME_DIR/gamescope-environment"
    [ -z "${DISPLAY:-}" ] || export DISPLAY
    [ -z "${GAMESCOPE_WAYLAND_DISPLAY:-}" ] || export GAMESCOPE_WAYLAND_DISPLAY
fi
if [ -n "${DISPLAY:-}" ] && { [ -z "${SDL_VIDEODRIVER:-}" ] || [ "$SDL_VIDEODRIVER" = offscreen ]; }; then
    SDL_VIDEODRIVER=x11
    export SDL_VIDEODRIVER
fi

DM_LINUX_OUT=${DM_LINUX_OUT:-"${BUNDLED_PACK:+$BUNDLED_PACK/out-linux}"}
DM_SHADER_DIR=${DM_SHADER_DIR:-"${BUNDLED_PACK:+$BUNDLED_PACK/shaders}"}
if [ ! -d "$DM_LINUX_OUT" ]; then DM_LINUX_OUT="$GAME_DATA/dm/out-linux"; fi
if [ ! -d "$DM_SHADER_DIR" ]; then DM_SHADER_DIR="$GAME_DATA/dm/shaders"; fi
DM_ROMFS=${DM_ROMFS:-"$GAME_DATA/romfs"}
DM_AOC=${DM_AOC:-"$GAME_DATA/aoc"}
DM_ROMFS_OVERLAY=${DM_ROMFS_OVERLAY:-"$GAME_DATA/dm/overlay"}
DM_SAVE=${DM_SAVE:-"$DM_ROOT/save/Diablo3Mobile"}
DM_TEMP=${DM_TEMP:-"$DM_ROOT/run/Diablo3Mobile/temp"}
DM_LANG=${DM_LANG:-ru-RU}
DM_LINUX_RENDER_HEIGHT=${DM_LINUX_RENDER_HEIGHT:-720}
DM_SETTINGS_FILE=${DM_SETTINGS_FILE:-"${XDG_CONFIG_HOME:-$HOME/.config}/diablo3-port/settings.conf"}
DM_FONT_FILE=${DM_FONT_FILE:-"$APPDIR/usr/share/diablo3-port/fonts/DejaVuSans.ttf"}
DM_AUDIO=${DM_AUDIO:-1}
if [ -z "${PULSE_SERVER:-}" ] && [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -S "$XDG_RUNTIME_DIR/pulse/native" ]; then
    PULSE_SERVER="unix:$XDG_RUNTIME_DIR/pulse/native"
fi
if [ -r "$DM_SETTINGS_FILE" ]; then
    while IFS='=' read -r key value; do
        case "$key" in
            lang) [ -z "$value" ] || DM_LANG=$value ;;
            handheld) [ "$value" = 1 ] && DM_OPMODE=0 || DM_OPMODE=1 ;;
            aspect)
                case "$value" in
                    1) DM_LINUX_ASPECT=1; unset DM_D3_WIDE ;;
                    2) DM_LINUX_ASPECT=0; DM_D3_WIDE=1 ;;
                    *) DM_LINUX_ASPECT=0; unset DM_D3_WIDE ;;
                esac ;;
            stretch_loading) DM_D3_WIDE_STRETCH_LOADING=$value ;;
            sharpen) [ "$value" = 0 ] && unset DM_GFX_SHARPEN || DM_GFX_SHARPEN=$value ;;
            fps) DM_PRESENT_MAX_HZ=$value ;;
            deadzone) DM_LINUX_DEADZONE=$value ;;
        esac
    done < "$DM_SETTINGS_FILE"
fi

for required in "$DM_LINUX_OUT/main.patched.bin" "$DM_LINUX_OUT/sdk.patched.bin" \
                "$DM_SHADER_DIR" "$DM_ROMFS/CPKs" "$DM_ROMFS/Update/CPKs"; do
    if [ ! -e "$required" ]; then
        printf 'Missing runtime input: %s\n' "$required" >&2
        printf 'Run ./setup.sh --target linux with your game files, or set DM_LINUX_OUT, DM_SHADER_DIR and DM_ROMFS.\n' >&2
        exit 1
    fi
done
if ! find "$DM_SHADER_DIR" -maxdepth 1 -type f -name '*.xgs' -print -quit | grep -q .; then
    printf 'No Vulkan shader bundles found in %s\n' "$DM_SHADER_DIR" >&2
    exit 1
fi

mkdir -p "$DM_SAVE" "$DM_TEMP"
export DM_ROOT DM_ROMFS DM_AOC DM_SAVE DM_TEMP DM_SHADER_DIR DM_LANG DM_LINUX_RENDER_HEIGHT DM_ROMFS_OVERLAY
export DM_OPMODE DM_LINUX_ASPECT DM_LINUX_DEADZONE DM_D3_WIDE DM_D3_WIDE_STRETCH_LOADING DM_GFX_SHARPEN DM_PRESENT_MAX_HZ DM_AUDIO PULSE_SERVER DM_FONT_FILE
LD_LIBRARY_PATH="$APPDIR/usr/lib/aarch64-linux-gnu:$APPDIR/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export LD_LIBRARY_PATH
exec "$APPDIR/usr/bin/dmhost" "$DM_LINUX_OUT" main sdk "$@"
